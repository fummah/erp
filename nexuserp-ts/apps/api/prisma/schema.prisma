generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserStatus { ACTIVE INVITED SUSPENDED }
enum InvoiceStatus { DRAFT POSTED PART_PAID PAID VOID }
enum FiscalStatus { NOT_REQUIRED READY PENDING SUBMITTED FISCALISED REJECTED RETRY }
enum FiscalDayStatus { CLOSED OPEN CLOSING ERROR }
enum DeviceStatus { UNREGISTERED ACTIVE SUSPENDED EXPIRED }
enum JournalStatus { DRAFT POSTED REVERSED }
enum AccountType { ASSET LIABILITY EQUITY REVENUE EXPENSE }
enum StockMovementType { RECEIPT ISSUE TRANSFER_IN TRANSFER_OUT ADJUSTMENT_IN ADJUSTMENT_OUT }
enum PurchaseOrderStatus { DRAFT APPROVED PART_RECEIVED RECEIVED CANCELLED }
enum LeadStatus { NEW QUALIFIED PROPOSAL WON LOST }
enum AssetStatus { ACTIVE IN_MAINTENANCE DISPOSED }
enum RiskStatus { OPEN MITIGATING ACCEPTED CLOSED }
enum IntegrationType { ZIMRA PAYNOW SMTP BANK WEBHOOK SSO STORAGE SMS WHATSAPP OTHER }

model Tenant {
  id String @id @default(uuid())
  name String
  slug String @unique
  active Boolean @default(true)
  companies Company[]
  memberships Membership[]
  subscription Subscription?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  legalName String
  tradingName String?
  code String
  tin String?
  vatNumber String?
  baseCurrency String @default("USD")
  financialYearStart Int @default(1)
  active Boolean @default(true)
  branches Branch[]
  memberships Membership[]
  accounts LedgerAccount[]
  journals JournalEntry[]
  customers Customer[]
  invoices SalesInvoice[]
  suppliers Supplier[]
  purchaseOrders PurchaseOrder[]
  items InventoryItem[]
  warehouses Warehouse[]
  employees Employee[]
  leads Lead[]
  assets Asset[]
  risks Risk[]
  complianceObligations ComplianceObligation[]
  auditLogs AuditLog[]
  integrations IntegrationConnection[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, code])
}

model Branch {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  name String
  code String
  address String?
  city String?
  active Boolean @default(true)
  fiscalDevices FiscalDevice[]
  warehouses Warehouse[]
  departments Department[]
  invoices SalesInvoice[]
  createdAt DateTime @default(now())
  @@unique([companyId, code])
}

model Department {
  id String @id @default(uuid())
  branchId String
  branch Branch @relation(fields:[branchId], references:[id], onDelete:Cascade)
  name String
  code String
  employees Employee[]
  @@unique([branchId, code])
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  firstName String
  lastName String
  status UserStatus @default(ACTIVE)
  isPlatformAdmin Boolean @default(false)
  memberships Membership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id String @id @default(uuid())
  userId String
  tenantId String
  companyId String
  role String @default("ADMIN")
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  @@unique([userId, companyId])
}

model SubscriptionPlan {
  id String @id @default(uuid())
  name String @unique
  monthlyPrice Decimal @db.Decimal(12,2)
  maxCompanies Int @default(1)
  maxUsers Int @default(5)
  features Json
  subscriptions Subscription[]
}

model Subscription {
  id String @id @default(uuid())
  tenantId String @unique
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  planId String
  plan SubscriptionPlan @relation(fields:[planId], references:[id])
  status String @default("ACTIVE")
  startsAt DateTime @default(now())
  endsAt DateTime?
}

model LedgerAccount {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  code String
  name String
  type AccountType
  parentId String?
  active Boolean @default(true)
  lines JournalLine[]
  @@unique([companyId, code])
}

model JournalEntry {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  number String
  date DateTime
  reference String?
  description String
  sourceType String
  sourceId String?
  status JournalStatus @default(POSTED)
  lines JournalLine[]
  createdAt DateTime @default(now())
  @@unique([companyId, number])
}

model JournalLine {
  id String @id @default(uuid())
  journalId String
  journal JournalEntry @relation(fields:[journalId], references:[id], onDelete:Cascade)
  accountId String
  account LedgerAccount @relation(fields:[accountId], references:[id])
  description String?
  debit Decimal @default(0) @db.Decimal(18,2)
  credit Decimal @default(0) @db.Decimal(18,2)
}

model Customer {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  code String
  name String
  email String?
  phone String?
  tin String?
  vatNumber String?
  creditLimit Decimal @default(0) @db.Decimal(18,2)
  invoices SalesInvoice[]
  @@unique([companyId, code])
}

model SalesInvoice {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  branchId String
  branch Branch @relation(fields:[branchId], references:[id])
  customerId String?
  customer Customer? @relation(fields:[customerId], references:[id])
  invoiceNo String
  invoiceDate DateTime @default(now())
  dueDate DateTime?
  currency String @default("USD")
  exchangeRate Decimal @default(1) @db.Decimal(18,6)
  subtotal Decimal @db.Decimal(18,2)
  taxTotal Decimal @db.Decimal(18,2)
  total Decimal @db.Decimal(18,2)
  status InvoiceStatus @default(DRAFT)
  fiscalRequired Boolean @default(true)
  fiscalStatus FiscalStatus @default(READY)
  lines SalesInvoiceLine[]
  fiscalReceipt FiscalReceipt?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId, invoiceNo])
}

model SalesInvoiceLine {
  id String @id @default(uuid())
  invoiceId String
  invoice SalesInvoice @relation(fields:[invoiceId], references:[id], onDelete:Cascade)
  description String
  itemId String?
  quantity Decimal @db.Decimal(18,4)
  unitPrice Decimal @db.Decimal(18,2)
  taxRate Decimal @default(0) @db.Decimal(8,4)
  taxAmount Decimal @default(0) @db.Decimal(18,2)
  lineTotal Decimal @db.Decimal(18,2)
  hsCode String?
}

model Supplier {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  code String
  name String
  email String?
  phone String?
  tin String?
  orders PurchaseOrder[]
  @@unique([companyId, code])
}

model PurchaseOrder {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  supplierId String
  supplier Supplier @relation(fields:[supplierId], references:[id])
  poNo String
  orderDate DateTime @default(now())
  status PurchaseOrderStatus @default(DRAFT)
  currency String @default("USD")
  total Decimal @db.Decimal(18,2)
  lines PurchaseOrderLine[]
  @@unique([companyId, poNo])
}

model PurchaseOrderLine {
  id String @id @default(uuid())
  purchaseOrderId String
  purchaseOrder PurchaseOrder @relation(fields:[purchaseOrderId], references:[id], onDelete:Cascade)
  description String
  itemId String?
  quantity Decimal @db.Decimal(18,4)
  unitPrice Decimal @db.Decimal(18,2)
  lineTotal Decimal @db.Decimal(18,2)
}

model InventoryItem {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  sku String
  name String
  unit String @default("EA")
  hsCode String?
  reorderLevel Decimal @default(0) @db.Decimal(18,4)
  trackBatch Boolean @default(false)
  trackSerial Boolean @default(false)
  active Boolean @default(true)
  movements StockMovement[]
  @@unique([companyId, sku])
}

model Warehouse {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  branchId String
  branch Branch @relation(fields:[branchId], references:[id])
  code String
  name String
  movements StockMovement[]
  @@unique([companyId, code])
}

model StockMovement {
  id String @id @default(uuid())
  warehouseId String
  warehouse Warehouse @relation(fields:[warehouseId], references:[id])
  itemId String
  item InventoryItem @relation(fields:[itemId], references:[id])
  type StockMovementType
  quantity Decimal @db.Decimal(18,4)
  unitCost Decimal @default(0) @db.Decimal(18,4)
  reference String?
  batchNo String?
  serialNo String?
  occurredAt DateTime @default(now())
}

model Employee {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  departmentId String?
  department Department? @relation(fields:[departmentId], references:[id])
  employeeNo String
  firstName String
  lastName String
  email String?
  hireDate DateTime
  basicSalary Decimal @default(0) @db.Decimal(18,2)
  currency String @default("USD")
  active Boolean @default(true)
  @@unique([companyId, employeeNo])
}

model StatutoryRule {
  id String @id @default(uuid())
  country String @default("ZW")
  authority String
  code String
  name String
  validFrom DateTime
  validTo DateTime?
  configuration Json
  active Boolean @default(true)
}

model Lead {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  name String
  companyName String?
  email String?
  phone String?
  status LeadStatus @default(NEW)
  estimatedValue Decimal @default(0) @db.Decimal(18,2)
  nextFollowUp DateTime?
}

model Asset {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  assetNo String
  name String
  category String
  location String?
  purchaseDate DateTime?
  cost Decimal @default(0) @db.Decimal(18,2)
  accumulatedDepreciation Decimal @default(0) @db.Decimal(18,2)
  status AssetStatus @default(ACTIVE)
  @@unique([companyId, assetNo])
}

model Risk {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  code String
  title String
  category String
  likelihood Int @default(1)
  impact Int @default(1)
  owner String?
  status RiskStatus @default(OPEN)
  mitigation String?
  @@unique([companyId, code])
}

model ComplianceObligation {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  authority String
  title String
  dueDate DateTime?
  frequency String?
  status String @default("OPEN")
  notes String?
}

model FiscalDevice {
  id String @id @default(uuid())
  branchId String
  branch Branch @relation(fields:[branchId], references:[id], onDelete:Cascade)
  name String
  serialNumber String
  zimraDeviceId String?
  status DeviceStatus @default(UNREGISTERED)
  certificateRef String?
  certificateExpiresAt DateTime?
  fiscalDayNo Int @default(0)
  receiptCounter Int @default(0)
  globalReceiptNo Int @default(0)
  dayStatus FiscalDayStatus @default(CLOSED)
  fiscalDays FiscalDay[]
  receipts FiscalReceipt[]
  logs FiscalIntegrationLog[]
  @@unique([branchId, serialNumber])
}

model FiscalDay {
  id String @id @default(uuid())
  deviceId String
  device FiscalDevice @relation(fields:[deviceId], references:[id], onDelete:Cascade)
  dayNo Int
  status FiscalDayStatus
  openedAt DateTime
  closedAt DateTime?
  receiptCount Int @default(0)
  grossTotal Decimal @default(0) @db.Decimal(18,2)
  taxTotal Decimal @default(0) @db.Decimal(18,2)
  @@unique([deviceId, dayNo])
}

model FiscalReceipt {
  id String @id @default(uuid())
  deviceId String
  device FiscalDevice @relation(fields:[deviceId], references:[id])
  invoiceId String @unique
  invoice SalesInvoice @relation(fields:[invoiceId], references:[id])
  fiscalDayNo Int
  receiptCounter Int
  globalReceiptNo Int
  receiptType String @default("FiscalInvoice")
  status FiscalStatus @default(PENDING)
  zimraReceiptId String?
  serverSignature String?
  receiptHash String?
  rawRequest Json?
  rawResponse Json?
  submittedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([deviceId, globalReceiptNo])
}

model FiscalIntegrationLog {
  id String @id @default(uuid())
  deviceId String
  device FiscalDevice @relation(fields:[deviceId], references:[id], onDelete:Cascade)
  operation String
  status String
  request Json?
  response Json?
  errorCode String?
  errorMessage String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id String @id @default(uuid())
  companyId String?
  company Company? @relation(fields:[companyId], references:[id], onDelete:SetNull)
  userId String?
  action String
  entityType String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
}

model IntegrationConnection {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete:Cascade)
  type IntegrationType
  provider String
  name String
  status String @default("NOT_CONFIGURED")
  baseUrl String?
  publicConfig Json?
  secretRef String?
  lastCheckedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId, type, provider, name])
}
